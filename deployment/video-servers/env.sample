# -----------------------------------------------------------------------------
# Eventyay Video Servers Environment Configuration
# -----------------------------------------------------------------------------

# Active service profiles (comma-separated list): proxy, janus, turn, jitsi
# Options:
#   - proxy  (Caddy reverse proxy with automatic self-signed TLS)
#   - janus  (Janus WebRTC gateway)
#   - turn   (Coturn STUN/TURN server)
#   - jitsi  (Jitsi Meet stack: Prosody, Jicofo, JVB, Web)
COMPOSE_PROFILES=proxy,janus,turn,jitsi

# Public IP address of the host (auto-detected via ipify/ifconfig.me if empty)
PUBLIC_IP=

# Optional Domain & Trusted TLS Configuration:
# - USE_SSLIP=1 (Default): Automatically routes through <PUBLIC_IP>.sslip.io and provisions
#   a real, trusted Let's Encrypt SSL certificate (eliminates browser cert warnings).
# - DOMAIN: Set a custom domain (e.g. video.example.com) pointing to this host.
# - USE_SSLIP=0: Disables wildcard DNS and falls back to raw IP with self-signed certificate.
USE_SSLIP=1
# DOMAIN=

# Optional public URL override (defaults to https://<DOMAIN> or https://<PUBLIC_IP>.sslip.io or https://<PUBLIC_IP>)
# PUBLIC_URL=https://video.example.com

# Janus Gateway room creation secret
JANUS_ROOM_CREATE_KEY=janusrocks

# Coturn STUN/TURN server shared authentication secret
COTURN_AUTH_SECRET=eventyay_coturn_secret
# COTURN_EXTERNAL_IP=
# COTURN_REALM=

# Jitsi Meet stack credentials & secrets
JWT_APP_ID=eventyay
JWT_APP_SECRET=change_me_to_a_secure_jwt_secret_in_production
JICOFO_AUTH_PASSWORD=eventyay_jicofo_secret_pass_123
JVB_AUTH_PASSWORD=eventyay_jvb_secret_pass_123
# JVB_ADVERTISE_IPS=
