{% extends 'account/email/base_message.jinja' %}

{% block title %}{{ _('Confirm your email address') }}{% endblock title %}

{% block heading %}{{ _('Confirm your email address') }}{% endblock heading %}

{% block content %}
  <p style='margin: 0 0 12px; font-size: 15px; line-height: 1.6;'>{{ _('Hello,') }}</p>
  <p style='margin: 0 0 24px; font-size: 15px; line-height: 1.6;'>
    {% block intro %}
      {{ _('Please confirm that %(email)s is your email address so you can use it with your %(instance)s account.', email=email, instance=INSTANCE_NAME) }}
    {% endblock intro %}
  </p>

  {% if code %}
    <p style='margin: 0 0 8px; font-size: 15px; line-height: 1.6;'>
      {{ _('Your email verification code is listed below. Please enter it in your open browser window.') }}
    </p>
    <p style='margin: 0 0 24px; font-size: 24px; font-weight: 600; letter-spacing: 4px; color: #222222;'>{{ code }}</p>
  {% else %}
    <table role='presentation' cellpadding='0' cellspacing='0' border='0' style='margin: 0 0 24px;'>
      <tr>
        <td style='border-radius: 4px; background-color: #2185d0;'>
          <a href='{{ activate_url }}' style='display: inline-block; padding: 12px 24px; color: #ffffff; font-size: 15px; font-weight: 600; text-decoration: none;'>
            {{ _('Verify email address') }}
          </a>
        </td>
      </tr>
    </table>
    <p style='margin: 0 0 4px; font-size: 13px; line-height: 1.6; color: #666666;'>
      {{ _("If the button doesn't work, copy and paste this link into your browser:") }}
    </p>
    <p style='margin: 0 0 24px; font-size: 13px; line-height: 1.6; word-break: break-all;'>
      <a href='{{ activate_url }}' style='color: #2185d0;'>{{ activate_url }}</a>
    </p>
  {% endif %}

  <hr style='margin: 0 0 20px; border: 0; border-top: 1px solid #e6e9ed;'>
  <p style='margin: 0 0 20px; font-size: 13px; line-height: 1.6; color: #666666;'>
    {% block ignore_notice %}
      {{ _("If you didn't request this, you can safely ignore this email.") }}
    {% endblock ignore_notice %}
  </p>
  <p style='margin: 0 0 24px; font-size: 15px; line-height: 1.6;'>
    {{ _('Thank you,') }}<br>
    {{ _('The %(instance)s team', instance=INSTANCE_NAME) }}
  </p>
{% endblock content %}
