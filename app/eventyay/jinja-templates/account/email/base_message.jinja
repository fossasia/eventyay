{#- HTML body for django-allauth emails. The plain-text alternative is still rendered from allauth's .txt templates. -#}
<!DOCTYPE html>
<html>
<head>
  <meta charset='utf-8'>
  <meta name='viewport' content='width=device-width, initial-scale=1'>
  <title>{% block title %}{% endblock title %}</title>
</head>
<body style='margin: 0; padding: 0; background-color: #f5f5f5;'>
  <table role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='background-color: #f5f5f5;'>
    <tr>
      <td align='center' style='padding: 24px 12px;'>
        <table role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='max-width: 560px; background-color: #ffffff; border: 1px solid #e6e9ed; border-radius: 8px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; color: #444444;'>
          <tr>
            <td style='padding: 18px 28px; background-color: #2185d0; border-radius: 8px 8px 0 0;'>
              <a href='{{ site_url }}' style='color: #ffffff; font-size: 20px; font-weight: 600; text-decoration: none;'>{{ INSTANCE_NAME }}</a>
            </td>
          </tr>
          <tr>
            <td style='padding: 32px 28px 8px;'>
              <h1 style='margin: 0 0 20px; color: #222222; font-size: 22px; font-weight: 500; line-height: 1.3;'>
                {% block heading %}{% endblock heading %}
              </h1>
              {% block content %}{% endblock content %}
            </td>
          </tr>
          <tr>
            <td style='padding: 16px 28px; background-color: #f7f9fb; border-top: 1px solid #e6e9ed; border-radius: 0 0 8px 8px; font-size: 13px; line-height: 1.6;'>
              <a href='{{ site_url }}' style='color: #2185d0; text-decoration: none;'>{{ settings.SITE_NETLOC }}</a><br>
              {% set mailto = contact_mailto() %}
              {% if mailto %}
                {{ _('Need help?') }}
                <a href='{{ mailto }}' style='color: #666666;'>{{ _('Contact us') }}</a>
              {% endif %}
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
